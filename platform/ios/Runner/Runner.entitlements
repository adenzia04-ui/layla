<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Requires the Family Controls (Distribution) entitlement, requested
	     from Apple. Until it is granted, remove this key or the build will
	     fail to sign. -->
	<key>com.apple.developer.family-controls</key>
	<true/>

	<!-- Shared between the app and both extensions. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.SMAG.noor</string>
	</array>
</dict>
</plist>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Screen Time. Development works on any paid team; shipping to the App
	     Store needs Apple's separate Family Controls distribution approval. -->
	<key>com.apple.developer.family-controls</key>
	<true/>

	<!-- Sign in with Apple. Without this key the authorisation request is
	     refused by iOS before it reaches Apple at all — the button appears to
	     work and then fails with error 1000, which looks like a bug in the app
	     rather than a missing capability. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>

	<!-- Shared container between the app and its extensions. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.adenzia.layla</string>
	</array>
</dict>
</plist>

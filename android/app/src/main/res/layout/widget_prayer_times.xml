<?xml version="1.0" encoding="utf-8"?>
<!-- The wider widget, drawn to match the iPhone one: the day above, the
     countdown to the next prayer, the six times in a three-by-two grid with
     the next one lit in gold, and tonight's Tahajjud underneath. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView android:id="@+id/header_today" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFD9B26A" android:textSize="10sp" android:textAllCaps="true" android:letterSpacing="0.09" android:text="Today" />
            <TextView android:id="@+id/header_hijri" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFF6F1E7" android:textSize="12sp" android:text=" " />
        </LinearLayout>

        <TextView
            android:id="@+id/header_city"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FF96A5BE"
            android:textSize="11sp"
            android:text=" " />
    </LinearLayout>

    <TextView
        android:id="@+id/until_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#FF96A5BE"
        android:textSize="12sp"
        android:text=" " />

    <Chronometer
        android:id="@+id/next_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFF6F1E7"
        android:textSize="20sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <LinearLayout
                android:id="@+id/cell0"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_margin="2dp"
                android:padding="5dp"
                android:background="@drawable/widget_cell">
                <TextView android:id="@+id/p0_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FF96A5BE" android:textSize="10sp" android:textAllCaps="true" android:letterSpacing="0.05" android:text=" " />
                <TextView android:id="@+id/p0_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFF6F1E7" android:textSize="15sp" android:text=" " />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/cell1"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_margin="2dp"
                android:padding="5dp"
                android:background="@drawable/widget_cell">
                <TextView android:id="@+id/p1_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FF96A5BE" android:textSize="10sp" android:textAllCaps="true" android:letterSpacing="0.05" android:text=" " />
                <TextView android:id="@+id/p1_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFF6F1E7" android:textSize="15sp" android:text=" " />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/cell2"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_margin="2dp"
                android:padding="5dp"
                android:background="@drawable/widget_cell">
                <TextView android:id="@+id/p2_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FF96A5BE" android:textSize="10sp" android:textAllCaps="true" android:letterSpacing="0.05" android:text=" " />
                <TextView android:id="@+id/p2_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFF6F1E7" android:textSize="15sp" android:text=" " />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <LinearLayout
                android:id="@+id/cell3"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_margin="2dp"
                android:padding="5dp"
                android:background="@drawable/widget_cell">
                <TextView android:id="@+id/p3_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FF96A5BE" android:textSize="10sp" android:textAllCaps="true" android:letterSpacing="0.05" android:text=" " />
                <TextView android:id="@+id/p3_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFF6F1E7" android:textSize="15sp" android:text=" " />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/cell4"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_margin="2dp"
                android:padding="5dp"
                android:background="@drawable/widget_cell">
                <TextView android:id="@+id/p4_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FF96A5BE" android:textSize="10sp" android:textAllCaps="true" android:letterSpacing="0.05" android:text=" " />
                <TextView android:id="@+id/p4_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFF6F1E7" android:textSize="15sp" android:text=" " />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/cell5"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_margin="2dp"
                android:padding="5dp"
                android:background="@drawable/widget_cell">
                <TextView android:id="@+id/p5_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FF96A5BE" android:textSize="10sp" android:textAllCaps="true" android:letterSpacing="0.05" android:text=" " />
                <TextView android:id="@+id/p5_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFF6F1E7" android:textSize="15sp" android:text=" " />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#FF96A5BE"
        android:textSize="10sp"
        android:text=" " />
</LinearLayout>

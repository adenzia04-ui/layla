<?xml version="1.0" encoding="utf-8"?>
<!-- minWidth/minHeight are what launchers before Android 12 size cells from
     (they round up by (size + 30) / 70); targetCellWidth/Height are what the
     ones after it use. Both have to say four by three or the list is cropped
     at the fifth prayer. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="180dp"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_prayer_list"
    android:previewLayout="@layout/widget_prayer_list"
    android:description="@string/widget_prayer_list_description"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />

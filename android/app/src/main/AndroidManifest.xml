<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Core -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Prayer times, Qibla, and the coarse cell used on the Tahajjud map -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Step 2 of the prayer confirmation: the prayer-mat photo. The
         gallery route goes through the system photo picker, which needs no
         permission, so READ_MEDIA_IMAGES is deliberately absent: Play treats
         it as broad gallery access and asks for a justification the app
         cannot honestly give. The camera plugin also asks for RECORD_AUDIO
         for video capture, which the app never does. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission
        android:name="android.permission.RECORD_AUDIO"
        tools:node="remove" />

    <!-- Prayer reminders -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Capped on purpose. Uncapped, SCHEDULE_EXACT_ALARM is denied by
         default from Android 14 and can be withdrawn at any time, and
         withdrawing it force-stops the app and cancels every alarm it had
         booked — which on this app means every prayer reminder and the whole
         prayer-focus schedule, silently. USE_EXACT_ALARM covers 33 and up
         and cannot be taken away. -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Optional soft lock. Both of these are OFF until the user turns the
         feature on in Profile → Reminders & focus, and Noor never records
         which apps are used. See docs/PRAYER_LOCK_LIMITATIONS.md. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- The compass. Declared not-required so the app still installs on
         devices without a magnetometer; the Qibla screen degrades to a
         numeric bearing. -->
    <uses-feature
        android:name="android.hardware.sensor.compass"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:label="Layla Pro"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:windowSoftInputMode="adjustResize">

            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Friend invites. The share sheet hands out layla://add?code=…
                 and the website's add.html falls back to it, so without this
                 filter every invite a Layla Pro user sends to an Android
                 phone lands nowhere. Matches the iOS CFBundleURLSchemes
                 entry. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="layla" />
            </intent-filter>

            <!-- Flutter reads the launch intent's data itself; this is what
                 turns that on. Same switch as FlutterDeepLinkingEnabled in
                 the iOS Info.plist. -->
            <meta-data
                android:name="flutter_deeplinking_enabled"
                android:value="true" />
        </activity>

        <!-- What a paused app opens to during a prayer window. Its own task
             so it replaces the app it covers rather than stacking on Layla,
             and out of Recents so it cannot be returned to after it closes. -->
        <activity
            android:name=".PrayerShieldActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity=".shield"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode" />

        <!-- Starts and stops the focus at each window edge, with the app
             closed. Without this the lock only ever engaged while somebody
             was already looking at Layla, which is the moment it is least
             needed. -->
        <receiver
            android:name=".PrayerWindowReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- The home-screen widgets. iOS has had these from the start on
             WidgetKit; these are the Android ones, drawn from the day the
             app already computed rather than a second copy of the maths. -->
        <receiver
            android:name=".NextPrayerWidget"
            android:exported="false"
            android:label="@string/widget_next_prayer_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_next_prayer_info" />
        </receiver>

        <receiver
            android:name=".PrayerTimesWidget"
            android:exported="false"
            android:label="@string/widget_prayer_times_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_prayer_times_info" />
        </receiver>

        <!-- The other nine. The iPhone has had these for a long time; these
             are the Android ones, drawn from the day the app already
             computed. Every one of them must also be listed in
             PrayerWidgets.PROVIDERS, or it draws once when it is placed and
             then never updates again. -->
        <receiver
            android:name=".PrayerListWidget"
            android:exported="false"
            android:label="@string/widget_prayer_list_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_prayer_list_info" />
        </receiver>

        <receiver
            android:name=".PrayerArcWidget"
            android:exported="false"
            android:label="@string/widget_prayer_arc_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_prayer_arc_info" />
        </receiver>

        <receiver
            android:name=".PrayWidget"
            android:exported="false"
            android:label="@string/widget_pray_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_pray_info" />
        </receiver>

        <receiver
            android:name=".PrayerTrackerWidget"
            android:exported="false"
            android:label="@string/widget_prayer_tracker_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_prayer_tracker_info" />
        </receiver>

        <receiver
            android:name=".DuasWidget"
            android:exported="false"
            android:label="@string/widget_duas_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_duas_info" />
        </receiver>

        <receiver
            android:name=".QiblaWidget"
            android:exported="false"
            android:label="@string/widget_qibla_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_qibla_info" />
        </receiver>

        <receiver
            android:name=".TasbihWidget"
            android:exported="false"
            android:label="@string/widget_tasbih_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_tasbih_info" />
        </receiver>

        <receiver
            android:name=".VerseWidget"
            android:exported="false"
            android:label="@string/widget_verse_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_verse_info" />
        </receiver>

        <receiver
            android:name=".NamesWidget"
            android:exported="false"
            android:label="@string/widget_names_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_names_info" />
        </receiver>


        <!-- Keeps the prayer window alive when the soft lock is enabled. -->
        <service
            android:name=".PrayerLockService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps a user-initiated prayer focus window active and returns the user to the prayer screen." />
        </service>

        <!-- flutter_local_notifications: exact alarms + reboot rescheduling -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver"
            android:exported="false" />
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>

        <!-- The app picker for the prayer focus.
             From Android 11 `queryIntentActivities` only returns apps the
             manifest has declared an interest in, so without this the picker
             would list a handful of system apps and none of the ones anybody
             actually loses ten minutes to. This is the sanctioned way to ask;
             QUERY_ALL_PACKAGES is the other one, and Play rejects it for
             anything but a launcher or an antivirus. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>

        <!-- The "Hear it" button on the Names of Allah.
             From Android 11 an app sees no other app it has not declared an
             interest in, and `flutter_tts` ships no queries of its own, so
             the plugin found no speech engine at all and every tap was
             silent — no error, no log, nothing to notice. -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>
</manifest>
